{
  "name": "whatsapp-desktop-linux",
  "version": "1.3.0",
  "description": "WhatsApp Desktop for Linux (unofficial)",
  "main": "dist/index.js",
  "scripts": {
    "dist": "tsc",
    "watch": "tsc -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "npm run dist && electron .",
    "build": "npm run dist && electron-builder",
    "build:appimage": "npm run dist && electron-builder --linux AppImage",
    "build:deb": "npm run dist && electron-builder --linux deb",
    "build:pacman": "npm run dist && electron-builder --linux pacman",
    "build:tar": "npm run dist && electron-builder --linux tar.gz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/araujo791/Whatsapp-Linux-Covenant.git"
  },
  "author": "Covenant",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "io.github.covenant.WhatsAppDesktop",
    "productName": "WhatsApp Desktop",
    "directories": {
      "output": "./build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      "data/**"
    ],
    "linux": {
      "category": "Network;Chat;InstantMessaging;",
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "data/icons/hicolor/512x512/apps/io.github.covenant.WhatsAppDesktop.png",
      "desktop": {
        "StartupWMClass": "whatsapp-desktop-linux"
      }
    }
  }
}
